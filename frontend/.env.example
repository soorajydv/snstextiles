# Where the Express API runs. In Vercel, set this to your deployed backend URL.
# /portal/api/* requests are proxied there by next.config.ts.
API_URL=http://localhost:4000
# Public URL prefix for the Next.js workspace. Change this without editing app links.
NEXT_PUBLIC_APP_BASE_PATH=/portal
# Show the public website / online shop and the Website section of the portal. Hidden unless set to true.
NEXT_PUBLIC_WEBSITE_ENABLED=false
# Canonical public website address, used for the sitemap, robots.txt and social sharing links.
NEXT_PUBLIC_SITE_URL=https://snstextiles.com
